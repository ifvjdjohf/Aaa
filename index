<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>霓虹互動視覺特效</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
        }
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #000;
            font-family: sans-serif;
        }
        canvas {
            display: block;
            width: 100%;
            height: 100%;
            background-color: #000;
        }
        .instruction {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            color: rgba(255, 255, 255, 0.4);
            font-size: 14px;
            pointer-events: none;
            letter-spacing: 2px;
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="instruction">點擊產生霓虹漣漪 | 長按喚醒線型生物</div>
    <canvas id="canvas"></canvas>

    <script>
        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');

        let width, height;
        
        function resize() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resize);
        resize();

        // 隨機顏色生成器（霓虹色調）
        function getRandomNeonColor() {
            const hues = [180, 280, 320, 60, 120]; // 青、紫、粉、黃、綠
            const hue = hues[Math.floor(Math.random() * hues.length)] + Math.random() * 20 - 10;
            return `hsl(${hue}, 100%, 60%)`;
        }

        // --- 1. 霓虹漣漪類別 ---
        class Ripple {
            constructor(x, y) {
                this.x = x;
                this.y = y;
                this.radius = 2;
                this.maxRadius = Math.random() * 80 + 100;
                this.speed = Math.random() * 3 + 2;
                this.color = getRandomNeonColor();
                this.alpha = 1;
                this.lineWidth = Math.random() * 3 + 2;
                this.alive = true;
            }

            update() {
                this.radius += this.speed;
                this.alpha = 1 - (this.radius / this.maxRadius);

                if (this.radius >= this.maxRadius || this.alpha <= 0) {
                    this.alive = false;
                }
            }

            draw(ctx) {
                if (!this.alive) return;
                ctx.save();
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                ctx.strokeStyle = this.color;
                ctx.globalAlpha = Math.max(0, this.alpha);
                ctx.lineWidth = this.lineWidth;
                ctx.shadowColor = this.color;
                ctx.shadowBlur = 15;
                ctx.stroke();
                ctx.restore();
            }
        }

        // --- 2. 線條發光蟲子（Segmented Worm）類別 ---
        class NeonCreature {
            constructor(x, y) {
                this.x = x;
                this.y = y;
                this.targetX = x;
                this.targetY = y;
                this.numSegments = 25;
                this.segmentLength = 12;
                this.segments = [];
                this.color = getRandomNeonColor();
                this.alpha = 0; // 從透明漸顯
                this.maxAlpha = 1;
                this.alive = true;
                this.decay = false;

                // 初始化蟲體節點（從起點向四周散開）
                for (let i = 0; i < this.numSegments; i++) {
                    this.segments.push({
                        x: x + Math.cos(i) * 5,
                        y: y + Math.sin(i) * 5
                    });
                }
            }

            updateTarget(x, y) {
                this.targetX = x;
                this.targetY = y;
            }

            despawn() {
                this.decay = true;
            }

            update() {
                // 淡入與淡出控制
                if (!this.decay) {
                    if (this.alpha < this.maxAlpha) this.alpha += 0.05;
                } else {
                    this.alpha -= 0.03;
                    if (this.alpha <= 0) {
                        this.alive = false;
                    }
                }

                // 頭部平滑移向目標（鼠標/觸控點）
                const head = this.segments[0];
                const dx = this.targetX - head.x;
                const dy = this.targetY - head.y;
                head.x += dx * 0.15;
                head.y += dy * 0.15;

                // 身軀節點跟隨機制（IK 鎖鏈跟隨）
                for (let i = 1; i < this.numSegments; i++) {
                    const prev = this.segments[i - 1];
                    const curr = this.segments[i];

                    const angle = Math.atan2(prev.y - curr.y, prev.x - curr.x);
                    curr.x = prev.x - Math.cos(angle) * this.segmentLength;
                    curr.y = prev.y - Math.sin(angle) * this.segmentLength;
                }
            }

            draw(ctx) {
                if (!this.alive) return;

                ctx.save();
                ctx.globalAlpha = Math.max(0, this.alpha);
                ctx.shadowColor = this.color;
                ctx.shadowBlur = 20;

                // 畫主脊椎曲線
                ctx.beginPath();
                ctx.moveTo(this.segments[0].x, this.segments[0].y);
                for (let i = 1; i < this.numSegments; i++) {
                    ctx.lineTo(this.segments[i].x, this.segments[i].y);
                }
                ctx.strokeStyle = this.color;
                ctx.lineWidth = 3;
                ctx.lineCap = 'round';
                ctx.stroke();

                // 畫橫向骨骼線條（讓牠看起來像科技生物蟲）
                for (let i = 0; i < this.numSegments; i++) {
                    const curr = this.segments[i];
                    const prev = this.segments[i - 1] || curr;
                    const angle = Math.atan2(curr.y - prev.y, curr.x - prev.x) + Math.PI / 2;

                    // 越接近尾部越細
                    const ribSize = Math.sin((i / this.numSegments) * Math.PI) * 12 + 2;

                    const x1 = curr.x + Math.cos(angle) * ribSize;
                    const y1 = curr.y + Math.sin(angle) * ribSize;
                    const x2 = curr.x - Math.cos(angle) * ribSize;
                    const y2 = curr.y - Math.sin(angle) * ribSize;

                    ctx.beginPath();
                    ctx.moveTo(x1, y1);
                    ctx.lineTo(x2, y2);
                    ctx.strokeStyle = '#fff';
                    ctx.lineWidth = 1.5;
                    ctx.stroke();
                }

                // 頭部亮點
                ctx.beginPath();
                ctx.arc(this.segments[0].x, this.segments[0].y, 5, 0, Math.PI * 2);
                ctx.fillStyle = '#fff';
                ctx.fill();

                ctx.restore();
            }
        }

        // --- 全局狀態管理 ---
        const ripples = [];
        const creatures = [];

        let isPointerDown = false;
        let pointerTimer = null;
        let activeCreature = null;
        let pointerX = 0;
        let pointerY = 0;

        const LONG_PRESS_TIME = 300; // 長按判定時間 (ms)

        function handlePointerStart(x, y) {
            isPointerDown = true;
            pointerX = x;
            pointerY = y;

            // 定時器：達到長按時間喚醒生物
            pointerTimer = setTimeout(() => {
                if (isPointerDown) {
                    // 創立新的發光生物
                    activeCreature = new NeonCreature(pointerX, pointerY);
                    creatures.push(activeCreature);
                }
            }, LONG_PRESS_TIME);
        }

        function handlePointerMove(x, y) {
            pointerX = x;
            pointerY = y;

            if (activeCreature) {
                activeCreature.updateTarget(x, y);
            }
        }

        function handlePointerEnd(x, y) {
            if (pointerTimer) clearTimeout(pointerTimer);

            // 如果不是長按（或者長按生物還沒生成），產生點擊漣漪
            if (!activeCreature) {
                ripples.push(new Ripple(x, y));
            } else {
                // 釋放長按生物，讓牠消失
                activeCreature.despawn();
                activeCreature = null;
            }

            isPointerDown = false;
        }

        // --- 事件監聽 (相容滑鼠與觸控) ---
        canvas.addEventListener('mousedown', (e) => handlePointerStart(e.clientX, e.clientY));
        canvas.addEventListener('mousemove', (e) => handlePointerMove(e.clientX, e.clientY));
        canvas.addEventListener('mouseup', (e) => handlePointerEnd(e.clientX, e.clientY));

        canvas.addEventListener('touchstart', (e) => {
            e.preventDefault();
            const touch = e.touches[0];
            handlePointerStart(touch.clientX, touch.clientY);
        }, { passive: false });

        canvas.addEventListener('touchmove', (e) => {
            e.preventDefault();
            const touch = e.touches[0];
            handlePointerMove(touch.clientX, touch.clientY);
        }, { passive: false });

        canvas.addEventListener('touchend', (e) => {
            e.preventDefault();
            const touch = e.changedTouches[0];
            handlePointerEnd(touch.clientX, touch.clientY);
        }, { passive: false });

        // --- 動畫主循環 ---
        function animate() {
            // 用半透明黑色刷新背景，產生輕微拖尾殘影特效
            ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';
            ctx.fillRect(0, 0, width, height);

            // 更新並繪製漣漪
            for (let i = ripples.length - 1; i >= 0; i--) {
                const r = ripples[i];
                r.update();
                r.draw(ctx);
                if (!r.alive) ripples.splice(i, 1);
            }

            // 更新並繪製生物
            for (let i = creatures.length - 1; i >= 0; i--) {
                const c = creatures[i];
                c.update();
                c.draw(ctx);
                if (!c.alive) creatures.splice(i, 1);
            }

            requestAnimationFrame(animate);
        }

        animate();
    </script>
</body>
</html>
